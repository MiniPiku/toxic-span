# Copy to .env and fill in. Never commit .env.
# Which LLM to use: gemini (Google, has a free tier) or anthropic (Claude).
# If unset: gemini when GEMINI_API_KEY is set, else anthropic.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds between Gemini calls (free tier is about 15 requests/minute)
GEMINI_MIN_INTERVAL=4.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
